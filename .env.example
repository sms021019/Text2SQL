# Local defaults for running the backend directly on the host (e.g. `uv run
# uvicorn app.main:app`). Under `docker compose up`, APP_DB_URL and
# TARGET_DB_URL are always overridden by docker-compose.yml to point at the
# `postgres` service instead of localhost -- edit those there, not here, if
# you need to change how the containers reach each other.
#
# LLM_BASE_URL is left unset here on purpose: docker-compose.yml also reads
# this file to fill in `${LLM_BASE_URL:-http://ollama:11434}`, so leaving it
# unset lets compose default to the `ollama` service while a plain host run
# still falls back to Settings' own `http://localhost:11434` default. Only
# set LLM_BASE_URL here if you want to point at something else in both
# places (e.g. the OpenAI block below).
APP_DB_URL=postgresql+asyncpg://app:app@localhost:5432/app
TARGET_DB_URL=postgresql+asyncpg://readonly:readonly@localhost:5432/target

LLM_PROVIDER=ollama
LLM_API_KEY=unused
LLM_MODEL=qwen2.5-coder:7b
EMBED_MODEL=nomic-embed-text
LLM_TIMEOUT_S=60.0

RETRIEVE_TOP_K=4
MAX_ROWS=500
STATEMENT_TIMEOUT_MS=5000
PROMPT_VERSION=v1
CORS_ORIGINS=["http://localhost:5173"]

# Like APP_DB_URL/TARGET_DB_URL, REDIS_URL is overridden by
# docker-compose.yml under `docker compose up` to point at the `redis`
# service instead of localhost.
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
SQL_CACHE_TTL_S=86400
RESULT_CACHE_TTL_S=300
SCHEMA_CACHE_TTL_S=604800

# To use OpenAI instead of Ollama, comment out the Ollama LLM_* lines above
# and uncomment this block:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com
# LLM_MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-small
# LLM_API_KEY=sk-...
